# ==================== MONGODB CONFIGURATION ====================
# MongoDB connection settings
DB_HOST=localhost
DB_PORT=27017
DB_NAME=data_collection
DB_USER=
DB_PASSWORD=

# Nếu MongoDB có authentication, uncomment và điền thông tin:
# DB_USER=your_username
# DB_PASSWORD=your_password

# Nếu MongoDB chạy trên server khác, thay đổi DB_HOST:
# DB_HOST=192.168.1.100

# Nếu MongoDB dùng connection string (MongoDB Atlas hoặc cloud):
# Có thể sử dụng connection string trực tiếp trong code nếu cần
# Ví dụ: mongodb+srv://username:password@cluster.mongodb.net/database

# ==================== FLASK CONFIGURATION ====================
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True

# ==================== PEXELS API ====================
# Lấy API key tại: https://www.pexels.com/api/
PEXELS_API_KEY=

# ==================== MINIO CONFIGURATION ====================
# MinIO Object Storage settings
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=False
UPLOAD_TO_MINIO=true

# Bucket names (sẽ được tạo tự động)
MINIO_BUCKET_VIDEOS=videos
MINIO_BUCKET_IMAGES=images
MINIO_BUCKET_FRAMES=dataset
MINIO_BUCKET_CAMERA=dataset
MINIO_BUCKET_VEHICLE_DETECTION=vehicle-detection

# ==================== FRAME EXTRACTION CONFIGURATION ====================
# Cứ bao nhiêu giây lấy 1 ảnh (mặc định 1.0 giây)
# Frame step sẽ được tính tự động: frame_step = fps * interval_seconds
# Ví dụ: fps=30, interval=1.0 → frame_step=30 (mỗi 1 giây lấy 1 ảnh)
# Ví dụ: fps=60, interval=1.0 → frame_step=60 (mỗi 1 giây lấy 1 ảnh)
# Ví dụ: fps=30, interval=0.5 → frame_step=15 (mỗi 0.5 giây lấy 1 ảnh)
FRAME_INTERVAL_SECONDS=1.0

