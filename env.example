# ==================== MONGODB CONFIGURATION ====================
# MongoDB connection settings
DB_HOST=localhost
DB_PORT=27017
DB_NAME=data_collection
DB_USER=
DB_PASSWORD=

# Nếu MongoDB có authentication, uncomment và điền thông tin:
# DB_USER=your_username
# DB_PASSWORD=your_password

# Nếu MongoDB chạy trên server khác, thay đổi DB_HOST:
# DB_HOST=192.168.1.100

# Nếu MongoDB dùng connection string (MongoDB Atlas hoặc cloud):
# Có thể sử dụng connection string trực tiếp trong code nếu cần
# Ví dụ: mongodb+srv://username:password@cluster.mongodb.net/database

# ==================== FLASK CONFIGURATION ====================
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=True

# ==================== PEXELS API ====================
# Lấy API key tại: https://www.pexels.com/api/
PEXELS_API_KEY=

